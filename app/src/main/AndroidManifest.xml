<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".LearnAnywhereApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_vehicle"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.LearnAnywhere"
        tools:targetApi="34">

        <!-- ===== Phone: the main drive-time UI (docs + agent + TTS) ===== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== Android Auto: media app (MediaBrowserService) =====
             AA discovers this as a MEDIA app. Each added document is a media
             item; Play/Pause/Next/Prev/speed flow from the head unit to the
             shared AudiobookPlayer. The phone screen stays available in
             parked mode for agent discourse and figures. -->
        <service
            android:name=".car.LearnStudyMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Advertise LearnAnywhere as a media app to Android Auto. Required:
             AA only surfaces apps that carry this meta-data. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

    </application>
</manifest>
